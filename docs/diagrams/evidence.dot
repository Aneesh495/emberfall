digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="Package and evidence lineage"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 source [label="Trusted commit and input bytes"]
 build [label="Compile engine and shaders"]
 cook [label="Cook content manifest"]
 package [label="Standalone game package"]
 raw [label="Execute workloads and save raw records"]
 verify [label="Recompute metrics and replay"]
 controls [label="Rehashed semantic mutations"]
 source -> build -> {cook raw}
 cook -> {package raw}
 raw -> verify
 source -> verify
 controls -> verify
 }
