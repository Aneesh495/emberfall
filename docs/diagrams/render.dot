digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="Vulkan frame graph"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 depth [label="Directional depth write"]
 scene [label="Opaque HDR and scene depth"]
 map [label="Exposure and edge filter"]
 ui [label="Blend overlay"]
 read [label="Optional framebuffer copy"]
 present [label="Present"]
 depth -> scene [label="sample depth"]
 scene -> map [label="sample HDR"]
 map -> ui -> present
 ui -> read -> present
 }
