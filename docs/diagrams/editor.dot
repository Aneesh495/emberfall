digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="Edit world and play world"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 source [label="Saved scene"]
 candidate [label="Validated transaction candidate"]
 document [label="Editable scene and history"]
 play [label="Independent play world"]
 journal [label="Recovery journal"]
 source -> document
 document -> candidate -> document
 document -> play
 document -> journal
 document -> source [label="atomic save"]
 }
