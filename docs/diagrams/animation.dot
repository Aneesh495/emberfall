digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="Cloth animation flow"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 inputs [label="Stride phase and speed"]
 clip [label="Sample key tracks"]
 rest [label="Rest pose"]
 blend [label="Blend local joint transforms"]
 palette [label="Hierarchy and inverse bind"]
 mesh [label="Skin vertex positions and normals"]
 gpu [label="Upload to frame slot"]
 inputs -> clip -> blend -> palette -> mesh -> gpu
 rest -> blend
 }
