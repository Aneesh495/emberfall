digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="Cook and stream asset versions"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 catalog [label="Catalog GUID and source bytes"]
 cache [label="Dependency hash"]
 compose [label="Compose and validate scene"]
 version [label="Stage immutable scene"]
 lease [label="Publish and lease version"]
 corrupt [label="Keep previous version on failed reload", fillcolor="#ffe6d8"]
 catalog -> cache -> compose -> version -> lease
 version -> corrupt
 }
