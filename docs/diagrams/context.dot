digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="Engine boundaries"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 source [label="Scene and prefab sources"]
 cooker [label="Catalog and cooker"]
 runtime [label="Game world and tick systems"]
 editor [label="Editor document and play world"]
 renderer [label="Vulkan frame graph"]
 session [label="Authoritative UDP session"]
 source -> cooker -> runtime -> renderer
 source -> editor -> runtime
 runtime -> session [dir=both]
 }
