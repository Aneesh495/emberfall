digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="Entity migration"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 handle [label="Entity slot and generation"]
 index [label="Validate slot"]
 old [label="Source archetype row"]
 new [label="Append destination row"]
 swap [label="Swap-remove old row"]
 fix [label="Repair moved slot and update handle row"]
 reject [label="Reject stale generation", fillcolor="#ffe6d8"]
 handle -> index -> old -> new -> swap -> fix
 index -> reject
 }
