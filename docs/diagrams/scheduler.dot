digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="Worker ownership and barrier"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 validate [label="Validate DAG and access declarations"]
 queue [label="Bounded ready queue"]
 a [label="Worker A owns range A"]
 b [label="Worker B owns range B"]
 c [label="Worker C owns range C"]
 barrier [label="Join completed batch"]
 extract [label="Consume immutable result"]
 validate -> queue
 queue -> {a b c}
 {a b c} -> barrier -> extract
 }
