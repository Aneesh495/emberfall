digraph Emberfall {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.22, labelloc=t, fontname="Helvetica", fontsize=20, label="One game tick"];
  node [shape=box, style="rounded,filled", fillcolor="#e7f4f3", color="#317775", fontname="Helvetica", fontsize=12, margin="0.18,0.11"];
  edge [color="#5f737e", fontname="Helvetica", fontsize=10];

 commands [label="Collect two slot commands"]
 devices [label="Sample relays and move devices"]
 rebuild [label="Build current collider order"]
 sweep [label="Carry platform riders and sweep actors"]
 interactions [label="Apply interactions in slot order"]
 outcome [label="Checkpoint, fall, or exit event"]
 commands -> devices -> rebuild -> sweep -> interactions -> outcome
 }
